# Backend Configuration
PS16_APP_ENV=development
PS16_DEBUG=true
PS16_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PS16_SESSION_TOKEN_SECRET=ps16-dev-secret-key-32-characters-minimum-for-security

# MongoDB Atlas URI (falls back automatically to in-memory store if unset or offline)
PS16_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
PS16_MONGODB_DATABASE=ps16_assistive_ai
PS16_USE_MOCK_DB=true

# ElevenLabs API Key (for Scribe STT and Voice TTS)
PS16_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
PS16_ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# LLM Provider Key (for intent ranking and conversational context)
PS16_LLM_API_KEY=your_gemini_or_openai_api_key_here
PS16_LLM_MODEL=gemini-1.5-flash

